# Backend env (copy to .env to run locally).
# Mongo: defaults to localhost.
# Gemini: leave GEMINI_API_KEY blank for DEMO MODE (mocked AI, every endpoint still works).

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MONGO_URI=mongodb://127.0.0.1:27017/edupulse
JWT_SECRET=change-me-in-production-32bytes-minimum-please
WELLBEING_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PORT=5050
